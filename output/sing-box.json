{
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-1",
      "server": "example.com",
      "server_port": 80,
      "uuid": "$vlessUUID"
    },
    {
      "type": "vless",
      "tag": "vless-2",
      "server": "host.com",
      "server_port": 443,
      "uuid": "uuid",
      "tls": {
        "enabled": true,
        "server_name": "host.com",
        "insecure": true
      }
    },
    {
      "type": "selector",
      "tag": "AUTO",
      "outbounds": [
        "vless-1",
        "vless-2"
      ]
    }
  ]
}